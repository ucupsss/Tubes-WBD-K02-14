        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (job, pool) (rate(dbmp_db_pool_acquire_wait_seconds_total[5m])) / clamp_min(sum by (job, pool) (rate(dbmp_db_pool_acquires_total[5m])), 1e-9)",
