    {
      "id": 15,
      "title": "Rata-rata waktu tunggu koneksi pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total waktu tunggu dibagi jumlah pengambilan koneksi dalam 5 menit terakhir.",
